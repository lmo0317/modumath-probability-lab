# लघु = १, गुरु = २ । An ordered rhythm is read left to right.
# Print a pattern only after its beat budget reaches zero.
कार्यम् विन्यासाः(शेषम्, क्रमः) {
    यदि (शेषम् == ०) {
        मुद्रय(क्रमः)।
        प्रत्यागच्छ १।
    }
    मान कुलम् = विन्यासाः(शेषम् - १, क्रमः + "L")।
    यदि (शेषम् >= २) {
        कुलम् = कुलम् + विन्यासाः(शेषम् - २, क्रमः + "G")।
    }
    प्रत्यागच्छ कुलम्।
}
प्रत्येकम् (मात्राः अन्तः परास(४, ७)) {
    मुद्रय("n =", मात्राः)।
    मुद्रय("count =", विन्यासाः(मात्राः, ""))।
}
