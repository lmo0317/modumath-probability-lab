# Read both times on the same 24-hour clock. The journey is under one day.
सूत्र अवधि(घंटा१, मिनट१, घंटा२, मिनट२) {
    मान शुरुआत = घंटा१ * ६० + मिनट१;
    मान अंत = घंटा२ * ६० + मिनट२;
    यदि (अंत < शुरुआत) {
        अंत = अंत + २४ * ६०;
    }
    फल अंत - शुरुआत;
}

वद(अवधि(२३, ४८, ०, १७));
वद(अवधि(७, ५०, ८, १०));
वद(अवधि(२३, ५९, ०, ०));
वद(अवधि(६, ५, ६, ५));
